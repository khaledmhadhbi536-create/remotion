{
  "name": "nawar-promo",
  "version": "1.0.0",
  "description": "Pack Pousse des Cheveux 3 en 1 \u2014 30s Tunisian promo video (1080x1080) built with Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.532",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "audio": "node scripts/generate-audio.mjs",
    "render": "remotion render HairPackAd renders/pack-cheveux-5en1-49dt-1x1.mp4 --codec=h264 --crf=20",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:reel": "remotion render HairPackReel renders/pack-cheveux-5en1-49dt-9x16.mp4 --codec=h264 --crf=20",
    "render:feed": "remotion render HairPackFeed45 renders/pack-cheveux-5en1-49dt-4x5.mp4 --codec=h264 --crf=20",
    "render:all": "npm run render && npm run render:feed && npm run render:reel && npm run covers",
    "covers": "remotion still HairPackAd renders/cover-1x1.jpg --frame=60 && remotion still HairPackFeed45 renders/cover-4x5.jpg --frame=60 && remotion still HairPackReel renders/cover-9x16.jpg --frame=60",
    "statics": "for id in A-Deal B-Early C-Natural D-Gift; do for f in 4x5 9x16; do remotion still Static-$id-$f renders/statics/static-$id-$f.jpg --jpeg-quality=95 || exit 1; done; done",
    "campaign": "bash scripts/render-campaign.sh",
    "noura:dev": "remotion studio",
    "noura:audio": "node scripts/generate-noura-audio.mjs",
    "noura:render": "remotion render NouraAd renders/noura/noura-huile-eclat-30s-1x1.mp4 --codec=h264 --crf=20",
    "noura:cover": "remotion still NouraAd renders/noura/cover-1x1.jpg --frame=57 --jpeg-quality=95"
  }
}
