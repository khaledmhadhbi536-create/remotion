 "subs": [
  {
   "start": 0.9,
   "end": 4.648,
   "text": "Vous cherchez un centre d'allemand qui sort de l'ordinaire ?",
   "rtl": false
  },
  {
   "start": 4.948,
   "end": 8.252,
   "text": "في Al Mozon Academy، اخترنالك فضاء مختلف، فيلا",
   "rtl": true
  },
  {
   "start": 8.252,
   "end": 11.915,
   "text": "راقية وحديقة تعطيك الراحة والجو المناسب باش تتعلّم.",
   "rtl": true
  },
  {
   "start": 12.615,
   "end": 16.018,
   "text": "Parce que la réussite commence par un bon encadrement.",
   "rtl": false
  },
  {
   "start": 16.318,
   "end": 19.421,
   "text": "مع أساتذة أكفاء وعندهم الخبرة، يرافقوك خطوة",
   "rtl": true
  },
  {
   "start": 19.421,
   "end": 22.451,
   "text": "بخطوة باش تطوّر مستواك في اللغة الألمانية.",
   "rtl": true
  },
  {
   "start": 23.151,
   "end": 26.899,
   "text": "Un espace exceptionnel, dans un emplacement privilégié à Ben Arous.",
   "rtl": false
  },
  {
   "start": 27.199,
   "end": 31.666,
   "text": "موش كان تقرا الألمانية، زادة تتعلّم في محيط مريح ومميّز.",
   "rtl": true
  },
  {
   "start": 32.366,
   "end": 34.647,
   "text": "Des formations adaptées à tous les",
   "rtl": false
  },
  {
   "start": 34.647,
   "end": 36.19,
   "text": "niveaux : A1, A2, B1 et",
   "rtl": false
  },
  {
   "start": 36.19,
   "end": 38.873,
   "text": "B2, avec préparation aux examens Goethe.",
   "rtl": false
  },
  {
   "start": 39.173,
   "end": 43.64,
   "text": "مستقبلك يبدأ باللغة الألمانية، والبداية تكون مع Al Mozon Academy.",
   "rtl": true
  },
  {
   "start": 44.34,
   "end": 46.723,
   "text": "سجّل توا وخوذ بلاصتك !",
   "rtl": true
  }
 ],
