   "text": "Arous ? Notre centre est à Radès.",
   "rtl": false
  },
  {
   "start": 18.919,
   "end": 22.624,
   "text": "السنتر متاعنا موجود في رادس، قريب منك.",
   "rtl": true
  },
  {
   "start": 23.074,
   "end": 24.933,
   "text": "Programme flexible : sur place, ou",
   "rtl": false
  },
  {
   "start": 24.933,
   "end": 26.791,
   "text": "en ligne sur notre plateforme pro.",
   "rtl": false
  },
  {
   "start": 26.941,
   "end": 29.2,
   "text": "اللي ما ينجمش يجي، يقرا en ligne من دارو.",
   "rtl": true
  },
  {
   "start": 29.65,
   "end": 32.696,
   "text": "De A1 à B2, avec préparation aux examens Goethe.",
   "rtl": false
  },
  {
   "start": 34.946,
   "end": 38.731,
   "text": "مستقبلك يبدا مع Al Mozon Academy.",
