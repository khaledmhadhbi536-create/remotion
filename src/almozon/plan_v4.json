  },
  {
   "start": 9.363,
   "end": 11.703,
   "text": "La réussite commence par un bon encadrement.",
   "rtl": false
  },
  {
   "start": 11.853,
   "end": 14.986,
   "text": "عندنا أساتذة أكفاء، يرافقوك خطوة بخطوة.",
   "rtl": true
  },
  {
   "start": 15.436,
   "end": 16.905,
   "text": "Vous êtes à Radès ou à Ben",
   "rtl": false
  },
  {
   "start": 16.905,
