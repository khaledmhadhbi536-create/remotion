 "subs": [
  {
   "start": 0.6,
   "end": 2.935,
   "text": "Vous cherchez un centre d'allemand qui sort de l'ordinaire ?",
   "rtl": false
  },
  {
   "start": 3.085,
   "end": 5.993,
   "text": "في Al Mozon Academy، اخترنالك فضاء استثنائي",
   "rtl": true
  },
  {
   "start": 5.993,
   "end": 8.562,
   "text": "يعطيك الراحة والجو المناسب باش تتعلّم.",
   "rtl": true
  },
  {
   "start": 9.012,
   "end": 11.57,
   "text": "Parce que la réussite commence par un bon encadrement.",
   "rtl": false
  },
  {
   "start": 11.72,
   "end": 14.548,
   "text": "مع أساتذة أكفاء وعندهم الخبرة، يرافقوك خطوة",
   "rtl": true
  },
  {
   "start": 14.548,
   "end": 17.31,
   "text": "بخطوة باش تطوّر مستواك في اللغة الألمانية.",
   "rtl": true
  },
  {
   "start": 17.76,
   "end": 19.802,
   "text": "Vous êtes à Radès ou dans le gouvernorat",
   "rtl": false
  },
  {
   "start": 19.802,
   "end": 21.486,
   "text": "de Ben Arous ? Notre centre est à",
   "rtl": false
  },
  {
   "start": 21.486,
   "end": 23.017,
   "text": "Radès, tout près de chez vous.",
   "rtl": false
  },
  {
   "start": 23.167,
   "end": 25.325,
   "text": "إذا إنت في رادس ولا في ولاية بن",
   "rtl": true
  },
  {
   "start": 25.325,
   "end": 28.387,
   "text": "عروس، السنتر متاعنا موجود في رادس، قريب منك.",
   "rtl": true
  },
  {
   "start": 28.837,
   "end": 30.609,
   "text": "Et notre programme est flexible : si",
   "rtl": false
  },
  {
   "start": 30.609,
   "end": 32.332,
   "text": "vous ne pouvez pas venir sur place,",
   "rtl": false
  },
  {
   "start": 32.332,
   "end": 34.055,
   "text": "vous suivez vos cours en ligne, sur",
   "rtl": false
  },
  {
   "start": 34.055,
   "end": 35.877,
   "text": "notre plateforme pro, à votre rythme.",
   "rtl": false
  },
  {
   "start": 36.027,
   "end": 38.346,
   "text": "اللي ما ينجمش يقرا sur place، ينجم يقرا",
   "rtl": true
  },
  {
   "start": 38.346,
   "end": 40.07,
   "text": "en ligne من دارو، وقت ما يحب.",
   "rtl": true
  },
  {
   "start": 40.52,
   "end": 43.02,
   "text": "Des formations adaptées à tous les",
   "rtl": false
  },
  {
   "start": 43.02,
   "end": 44.711,
   "text": "niveaux : A1, A2, B1 et",
   "rtl": false
  },
  {
   "start": 44.711,
   "end": 47.652,
   "text": "B2, avec préparation aux examens Goethe.",
   "rtl": false
  },
  {
   "start": 49.902,
   "end": 54.89,
   "text": "مستقبلك يبدأ باللغة الألمانية، والبداية تكون مع Al Mozon Academy.",
   "rtl": true
  },
  {
   "start": 55.34,
   "end": 58.203,
   "text": "اتصل بينا لمزيد من المعلومات !",
   "rtl": true
  }
 ],
